{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "distrobox-host-exec",
        "distrobox",
        "enter",
        "playwright-box",
        "--",
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--executable-path",
        "/home/braga/.cache/ms-playwright/chromium-1234/chrome-linux64/chrome",
        "--user-data-dir",
        ".playwright-mcp/profile"
      ],
      "enabled": true
    }
  }
}
